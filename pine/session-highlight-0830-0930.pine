//@version=6
indicator("Session Highlight 08:30-09:30", overlay = true)

// ── Inputs ────────────────────────────────────────────────────────────────
sessionTime = input.session("0830-0930", "Session window")
sessionTz   = input.string("America/New_York", "Time zone",
     options = ["America/New_York", "America/Chicago", "Europe/London", "UTC"])
shadeColor  = input.color(color.new(color.red, 80), "Shade colour")

// ── Logic ─────────────────────────────────────────────────────────────────
// time() returns na when the bar is outside the session window.
inSession = not na(time(timeframe.period, sessionTime + ":23456", sessionTz))

// Full-height vertical band over every bar inside the window.
bgcolor(inSession ? shadeColor : na, title = "Session shade")
